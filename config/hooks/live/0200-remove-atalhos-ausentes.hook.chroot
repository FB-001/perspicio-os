#!/bin/sh

set -eu

GERENCIADOR="/usr/share/plasma/plasmoids/org.kde.plasma.taskmanager/contents/config/main.xml"
KICKER="/usr/share/plasma/plasmoids/org.kde.plasma.kicker/contents/config/main.xml"
KICKOFF="/usr/share/plasma/plasmoids/org.kde.plasma.kickoff/contents/config/main.xml"

if [ -f "$GERENCIADOR" ]; then
    sed -i \
        '/<entry name="launchers"/,/<\/entry>/ s#<default>.*</default>#<default></default>#' \
        "$GERENCIADOR"
fi

for ARQUIVO in "$KICKER" "$KICKOFF"
do
    [ -f "$ARQUIVO" ] || continue

    sed -i \
        '/<entry name="favorites"/,/<\/entry>/ s#<default>.*</default>#<default></default>#' \
        "$ARQUIVO"
done
